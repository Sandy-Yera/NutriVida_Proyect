# Copiar como .env (nunca subir el .env real al repositorio).
# Lo lee docker-compose.yml (que se lo pasa a los 3 microservicios). Desde el IDE hay que exportarlas en la terminal.

# MySQL 8 (docker-compose.yml). Si XAMPP ocupa el 3306, usa DB_PORT=3307.
MYSQL_ROOT_PASSWORD=root_dev
DB_USER=nutrivida
DB_PASSWORD=nutrivida_dev
DB_PORT=3306

# JWT HS256 común a ms-usuarios, ms-citas y ms-clinica: mínimo 32 caracteres.
# Generar uno propio, por ejemplo en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=reemplazar-por-un-secreto-propio-de-al-menos-32-caracteres

# Puerto donde se abre la app completa (Nginx): http://localhost:8080
WEB_PORT=8080

# Cómo ms-citas obtiene horarios y servicios de ms-clinica:
#   auto      ms-clinica y, si no responde o aún no tiene el endpoint, las semillas de EP2 (por defecto)
#   http      solo ms-clinica; si no responde, 503 (usar en el video y la entrega)
#   simulado  solo las semillas de EP2
NUTRIVIDA_CLINICA_MODO=auto

# Cómo ms-citas revisa que la cuenta del token siga activa (R8), con los mismos tres modos:
#   auto      ms-usuarios y, si no responde o aún no tiene GET /api/usuarios/{id}, las semillas de EP2
#   http      solo ms-usuarios; si no responde, 503 (usar en el video y la entrega)
#   simulado  solo las semillas de EP2 (las 9 cuentas activas)
NUTRIVIDA_USUARIOS_MODO=auto

# Perfiles de ms-citas. "dev" agrega POST /api/dev/token: es el plan B mientras ms-usuarios no
# tenga login (el frontend lo usa para conseguir un token). NUNCA en el video ni en la entrega:
# ahí va MS_CITAS_PERFILES=mysql.
MS_CITAS_PERFILES=mysql,dev

# Modo del frontend dentro de Docker: api (microservicios) o local (datos de EP2).
VITE_API_MODE=api
