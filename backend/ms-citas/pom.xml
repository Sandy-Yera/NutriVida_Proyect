<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Misma base que la solución DoggySpa del curso: Java 21 y Spring Boot 4.1.x -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>cl.duoc.nutrivida</groupId>
    <artifactId>ms-citas</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ms-citas</name>
    <description>NutriVida · Citas, disponibilidad, pagos simulados y estadísticas. Dueño: Simon.</description>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>
    <dependencies>
        <!-- Igual que DoggySpa -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>3.1.1</version></dependency>
        <!-- H2: perfil por defecto y pruebas. MySQL 8: perfil "mysql" (docker-compose.dev.yml) -->
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
        <!-- EP3: JWT y roles -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>${jjwt.version}</version></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-gson</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>
        <!-- Pruebas -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
        <!-- PIT lanza las pruebas con el launcher de JUnit; la versión la fija Spring Boot -->
        <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <!--
              Pruebas mutantes (PIT) de la lógica de cálculo: bloques, 24 h, 60 días, estadísticas,
              Luhn, vencimiento y correlativos. PIT cambia el código compilado (por ejemplo, > por >=,
              + por -, true por false) y vuelve a correr las pruebas: cada cambio que ninguna prueba
              detecta es una prueba que falta. No corre con "mvn test"; se pide aparte:
                scripts\verificar.ps1 -Solo mutantes
              Reporte: backend/ms-citas/target/pit-reports/index.html
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.1</version>
                <dependencies>
                    <dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.3</version></dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>cl.duoc.nutrivida.citas.service.Reglas*</param>
                        <param>cl.duoc.nutrivida.citas.model.Contador</param>
                        <param>cl.duoc.nutrivida.citas.model.EstadoCita</param>
                        <param>cl.duoc.nutrivida.citas.model.Cita</param>
                        <param>cl.duoc.nutrivida.citas.dto.Tarjeta</param>
                        <param>cl.duoc.nutrivida.citas.dto.ServicioClinica</param>
                    </targetClasses>
                    <!-- Getters y setters de las entidades y accesores de ServicioClinica (record): sin lógica, no se mutan. -->
                    <excludedMethods>
                        <param>get*</param><param>set*</param>
                        <param>codigo</param><param>tipo</param><param>nombre</param><param>duracionMin</param>
                        <param>modalidad</param><param>precio</param><param>activo</param>
                    </excludedMethods>
                    <targetTests>
                        <param>cl.duoc.nutrivida.citas.service.Reglas*Test</param>
                        <param>cl.duoc.nutrivida.citas.model.*Test</param>
                        <param>cl.duoc.nutrivida.citas.dto.*Test</param>
                    </targetTests>
                    <mutators><mutator>STRONGER</mutator></mutators>
                    <outputFormats><param>HTML</param><param>XML</param></outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>4</threads>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
