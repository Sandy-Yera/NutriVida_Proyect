# Copiar como frontend/.env.local (no se sube al repositorio).

# Modo dual (EP3):
#   api   → los services llaman a los microservicios (levantar backend primero)
#   local → datos simulados de EP2 en localStorage (por defecto; así corren las pruebas)
VITE_API_MODE=local

# Vacío = mismo origen, a través del proxy de vite.config.js (recomendado en desarrollo).
# Solo si se sirve el frontend aparte: VITE_API_URL=http://localhost:8082
VITE_API_URL=
